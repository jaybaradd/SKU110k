# Copy to .env for local configuration. Do not commit .env.

# Path to the fine-tuned YOLO checkpoint. Modal must override this with
# the path where the checkpoint is packaged inside its container.
YOLO_WEIGHTS_PATH=weights/best.pt

# Set this to the deployed Modal POST /predict URL for the Streamlit client.
PREDICT_API_URL=

# Validated inference defaults from the notebook and implementation handoff.
# Keep these unchanged unless a later review explicitly approves a change.
# YOLO_IMAGE_SIZE=1280
# DETECTION_CONFIDENCE=0.25
# DETECTION_IOU=0.70
# MAX_DETECTIONS=750
# GROUPING_SIMILARITY=0.72
# GROUPING_LINKAGE=average
# DINO_MODEL_NAME=vit_small_patch14_dinov2.lvd142m
# DINO_BATCH_SIZE=4
# CROP_PAD_RGB=240,240,240
